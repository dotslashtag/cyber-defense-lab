```SOC - Workstation-to-Workstation Lateral Auth (OP-004 D2), v2 deployed 2026-10-13. Network (3) or RDP (10) logon arriving on a workstation from a peer workstation. The workstation set comes from the soc_workstations lookup (lookups/soc_workstations.csv: Windows hostname -> IP; case-insensitive match). The receiving host is identified by its Windows computer name, not the Wazuh agent name, so re-adding an agent cannot silently drop it. v1 hard-coded two agent names and an IP regex and missed WIN11-PB026.```
index=wazuh_archives "EventChannel"
| rex field=_raw "EventChannel (?<_json>\{.*\})$"
| spath input=_json
| rex field=_raw "\((?<agent_name>[^)]+)\)\s+any->EventChannel"
| rename "win.system.eventID" as eventID, "win.system.computer" as computer,
         "win.eventdata.logonType" as logonType, "win.eventdata.ipAddress" as srcip,
         "win.eventdata.targetUserName" as targetUser, "win.eventdata.ipPort" as srcport
| search eventID=4624 (logonType=3 OR logonType=10)
| eval dest_host=upper(mvindex(split(computer, "."), 0))
| lookup soc_workstations host AS dest_host OUTPUT ip AS dest_ip
| lookup soc_workstations ip AS srcip OUTPUT host AS src_host
| where isnotnull(dest_ip) AND isnotnull(src_host) AND srcip!=dest_ip
| table _time, agent_name, dest_host, src_host, srcip, targetUser, logonType, srcport
| sort - _time
